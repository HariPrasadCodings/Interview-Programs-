# ================================================================
# ENVIRONMENT VARIABLES - Docker Compose
# ================================================================
# This file is automatically loaded by Docker Compose and provides
# default values for all configurable parameters. Override these
# in your shell or in a .env.local file for environment-specific
# settings.
#
# SECURITY NOTE: This file contains default development credentials
# only. NEVER use these values in production. In production, inject
# secrets via a vault (HashiCorp Vault, AWS Secrets Manager, etc.)
# or environment-specific CI/CD variables.
# ================================================================

# ----- MySQL (Order Service) -----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=orderdb
MYSQL_USER=orderuser
MYSQL_PASSWORD=orderpass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ----- PostgreSQL (Payment Service) -----
POSTGRES_DB=paymentdb
POSTGRES_USER=paymentuser
POSTGRES_PASSWORD=paymentpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- MongoDB (Product Service - CQRS Read Model) -----
MONGO_DATABASE=productdb
MONGO_USER=mongouser
MONGO_PASSWORD=mongopass
MONGO_HOST=mongodb
MONGO_PORT=27017

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ----- Eureka (Service Discovery) -----
EUREKA_URL=http://eureka:password@discovery-server:8761/eureka/

# ----- JWT Authentication -----
# 256-bit secret key for HS256 signing (Base64-encoded)
# Generate a new one for production: openssl rand -base64 32
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS1mb3ItaW50ZXJ2aWV3LWRlbW8tMjAyNA==
JWT_EXPIRATION_MS=3600000

# ----- Service Ports -----
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8090
ORDER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
SAGA_ORCHESTRATOR_PORT=8086

# ----- Spring Profiles -----
SPRING_PROFILES_ACTIVE=docker
