<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         NOTIFICATION SERVICE
         ================================================================
         Demonstrates:
           - Event-Driven Architecture: Kafka consumers for order and
             payment events, translating domain events into user
             notifications (email, SMS, push).
           - Database-per-Service: H2 (dev) / dedicated datastore (prod)
             for notification persistence.
         ================================================================ -->

    <parent>
        <groupId>com.interview.microservices</groupId>
        <artifactId>microservices-design-patterns</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>notification-service</artifactId>
    <name>Notification Service</name>
    <description>
        Notification microservice demonstrating Event-Driven Architecture
        via Kafka consumers. Listens to order-events and payment-events
        topics and creates user notifications (email, SMS, push).
    </description>

    <dependencies>
        <!-- ==================== Spring Boot Starters ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== Spring Cloud ==================== -->
        <!-- Eureka Client - service registration & discovery -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- ==================== Kafka (Async Messaging) ==================== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ==================== Database ==================== -->
        <!-- H2 - in-memory database for development/demo -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== Internal Shared Module ==================== -->
        <dependency>
            <groupId>com.interview.microservices</groupId>
            <artifactId>common-dto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
